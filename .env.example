# Techset LeadGen settings (all optional). Save the lines you need as .env next to the
# data folder (the project folder, or the folder of TechsetLeadGen.exe); the application
# reads its TSLG_ settings and DATABASE_URL. Variables set in the shell or launcher win.
# User passwords are stored only as Argon2 hashes inside the database.

# The shared team database (PostgreSQL). Without it, the local file data/sales.db is used.
# The same address can be put in data/database.ini instead ([database] url = ...).
# It contains the database password: never commit it.
# DATABASE_URL=postgresql://tslg_app:PASSWORD@office-server:5432/techset_leadgen?sslmode=require

# Folder of the PostgreSQL client tools (pg_dump, pg_restore) for --backup-team-database.
# TSLG_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Where the database (sales.db), backups/, and rejected-row files live.
# Default: the data folder next to the project or executable.
# FDT_DATA_DIR=C:\Users\me\AppData\Local\TechsetLeadGen\data

# Where app.log and importer.log are written. Default: the logs folder.
# FDT_LOG_DIR=C:\Users\me\AppData\Local\TechsetLeadGen\logs
# TSLG_LOG_LEVEL=INFO

# Sign-in and session policy (defaults shown).
# TSLG_SESSION_IDLE_MINUTES=30
# TSLG_SESSION_ABSOLUTE_HOURS=12
# TSLG_LOGIN_MAX_FAILURES=5
# TSLG_LOGIN_WINDOW_MINUTES=15
# TSLG_TOKEN_TTL_HOURS=72
